{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:performance": "npm run test:e2e -- --grep=\"performance\"",
    "test:accessibility": "npm run test:e2e -- --grep=\"accessibility\"",
    "lighthouse": "lhci autorun",
    "lighthouse:desktop": "lighthouse --preset=desktop --output=html --output-path=./lighthouse-desktop.html",
    "lighthouse:mobile": "lighthouse --preset=mobile --output=html --output-path=./lighthouse-mobile.html",
    "performance:analyze": "npm run build && npm run lighthouse",
    "performance:full": "run-s build preview lighthouse test:performance",
    "bundle:analyze": "npm run build && npx vite-bundle-analyzer dist/bundle-analysis.html",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ci:test": "run-s lint test:coverage test:e2e",
    "ci:performance": "run-s build preview lighthouse test:performance",
    "ci:quality": "run-s lint test:coverage test:e2e performance:analyze"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.12",
    "@vicons/ionicons5": "^0.13.0",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.17",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1",
    "web-vitals": "^5.0.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-docs": "^9.0.18",
    "@storybook/addon-onboarding": "^9.0.18",
    "@storybook/vue3-vite": "^9.0.18",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.15.32",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/tsconfig": "^0.7.0",
    "axe-playwright": "^2.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-storybook": "^9.0.18",
    "eslint-plugin-vue": "~10.2.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "jiti": "^2.4.2",
    "lighthouse": "^12.8.0",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.54.1",
    "prettier": "3.5.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.89.2",
    "storybook": "^9.0.18",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-bundle-analyzer": "^0.0.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.2.10",
    "web-vitals-reporter": "^1.0.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
